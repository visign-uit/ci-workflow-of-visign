FROM node:20-alpine

WORKDIR /app

COPY package.json package-lock.json ./

# --no-audit --no-fund: bỏ log thừa, build nhanh hơn
RUN npm ci --no-audit --no-fund

COPY . .

# Chạy non-root để đúng chuẩn security (user "node" có sẵn trong node:alpine)
USER node

CMD ["sh", "-c", "npm run db:push && npm run db:prod"]
